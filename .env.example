# Torn City API Key
# Ottieni la tua chiave su: https://www.torn.com/preferences.php#tab=api
# Per il market analyzer basta una chiave "Public" o "Limited"
TORN_API_KEY=YOUR_TORN_API_KEY_HERE

# Parametri Flipping
MIN_PROFIT_PERCENT=10.0
MIN_PROFIT_VALUE=20000
MAX_BUY_BUDGET=100000000
POLL_INTERVAL_SECONDS=60
